# Copy to .env for local development (.env is gitignored).
# Deployed values live in the Vercel project's Environment Variables —
# Vite's loadEnv reads VITE_* from process.env at build time.
#
# These are the Supabase *publishable* (anon) keys, which ship to the browser
# by design. Never put a service-role key in here.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
VITE_SUPABASE_PROJECT_ID=<project-ref>
